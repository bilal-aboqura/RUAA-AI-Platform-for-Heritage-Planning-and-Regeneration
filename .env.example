# ─────────────────────────────────────────────────────────────────────────────
# re22 — Environment Variable Template
#
# Copy this file to .env and fill in the real values before deploying.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000

# Public base URL (used for constructing absolute asset URLs in API responses).
# Set this to your domain once DNS is pointed at the VPS.
APP_BASE_URL=https://yourdomain.com

# ── Database ──────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string (cloud-hosted, no local DB container needed).
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/re_spa?retryWrites=true&w=majority

# ── AI / Replicate ────────────────────────────────────────────────────────────
REPLICATE_API_TOKEN=r8_your_token_here
REPLICATE_GEMINI_MODEL=google/gemini-2.5-flash

# Optional: override the default 3D generation models
# REPLICATE_3D_MODEL=tencent/hunyuan-3d-3.1
# REPLICATE_3D_FALLBACK_MODEL=tencent/hunyuan3d-2

# Optional: override the scene-analysis model used by service 5
# SERVICE_05_SCENE_ANALYSIS_MODEL=openai/gpt-4o

# Optional: override the image generation model used by service 5
# SERVICE_05_IMAGE_MODEL=google/nano-banana-2:b7866a051519a43b5dda3ee54a3013c4813939a18af2b627f8f1dba876efd443

# ── Blender (optional — leave empty on Linux VPS) ─────────────────────────────
# If left empty the Blender-dependent render steps in Service 5 will be
# gracefully skipped. Install Blender on the VPS and set this path only if
# you need server-side Blender rendering.
BLENDER_PATH=
